{
  "name": "deejota-finanzas-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src tests-backend && cd .. && web/node_modules/.bin/oxlint apps-script shared scripts",
    "typecheck": "tsc -b",
    "test": "vitest run && vitest run --config vitest.backend.config.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "size": "node scripts/check-bundle-size.mjs",
    "test:ui": "vitest run",
    "test:backend": "vitest run --config vitest.backend.config.mjs",
    "sync:check": "node ../scripts/sync-shared.mjs --check",
    "docs:check": "node ../scripts/docs/generar-api.mjs --check && node ../scripts/matriz/generar.mjs --check",
    "bench": "vitest run src/engine/rendimiento.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
